<?xml version="1.0" encoding="utf-8"?>
<!--
    Orbi Design System — Paleta (tema claro)
    Baseada nos papéis de cor do Material 3. Todas as combinações texto/fundo
    respeitam contraste mínimo WCAG AA (4.5:1 para texto, 3:1 para elementos gráficos).
    As variantes do tema escuro ficam em values-night/colors.xml.
-->
<resources>
    <!-- Marca (10%) -->
    <color name="primary">#2557D6</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#DCE4FF</color>
    <color name="on_primary_container">#0A1F5C</color>
    <color name="inverse_primary">#B4C5FF</color>

    <color name="secondary">#565E71</color>
    <color name="on_secondary">#FFFFFF</color>
    <color name="secondary_container">#DDE2F3</color>
    <color name="on_secondary_container">#131C2B</color>

    <color name="tertiary">#146C2E</color>
    <color name="on_tertiary">#FFFFFF</color>
    <color name="tertiary_container">#C9F2D1</color>
    <color name="on_tertiary_container">#002108</color>

    <color name="error">#BA1A1A</color>
    <color name="on_error">#FFFFFF</color>
    <color name="error_container">#FFDAD6</color>
    <color name="on_error_container">#410002</color>

    <!-- Superfícies neutras (60%) -->
    <color name="background">#F8F9FC</color>
    <color name="on_background">#191C20</color>
    <color name="surface">#F8F9FC</color>
    <color name="on_surface">#191C20</color>
    <color name="surface_variant">#E1E2EC</color>
    <color name="on_surface_variant">#44474F</color>
    <color name="surface_container_lowest">#FFFFFF</color>
    <color name="surface_container_low">#F2F3F7</color>
    <color name="surface_container">#ECEDF1</color>
    <color name="surface_container_high">#E7E8EC</color>
    <color name="surface_container_highest">#E1E2E6</color>
    <color name="inverse_surface">#2E3035</color>
    <color name="inverse_on_surface">#F0F0F7</color>

    <!-- Contornos (30%) -->
    <color name="outline">#74777F</color>
    <color name="outline_variant">#C4C6D0</color>

    <!-- Status de rotas e entregas (texto / fundo da pílula) -->
    <color name="status_pending">#44474F</color>
    <color name="status_pending_bg">#E7E8EC</color>

    <color name="status_in_progress">#1F4FC2</color>
    <color name="status_in_progress_bg">#DCE4FF</color>

    <color name="status_completed">#146C2E</color>
    <color name="status_completed_bg">#D3F3DA</color>

    <color name="status_skipped">#8A5100</color>
    <color name="status_skipped_bg">#FFE3BF</color>

    <color name="status_delayed">#B3261E</color>
    <color name="status_delayed_bg">#FFE2DE</color>

    <color name="status_cancelled">#B3261E</color>
    <color name="status_cancelled_bg">#FFE2DE</color>

    <!-- Mapa e navegação -->
    <color name="nav_maneuver_bg">#0F172A</color>
    <color name="nav_maneuver_surface">#1E293B</color>
    <color name="nav_maneuver_accent">#38BDF8</color>
    <color name="map_background">#EEF0F4</color>
