<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Tema base do Orbi (Material 3, DayNight).
        60% Off-White (#F7F7F5 / #FFFFFF), 30% Preto Carbono (#0A0A0A), 10% Azul Orbi (#2557D6).
        As variantes escuras ficam em values-night/colors.xml e values-night/themes.xml.
    -->
    <style name="Base.Theme.Orbi_app" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cores -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorPrimaryInverse">@color/inverse_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/inverse_on_surface</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Tipografia global (Inter + cv11/ss01) -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Orbi.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Orbi.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Orbi.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Orbi.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Orbi.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Orbi.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Orbi.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Orbi.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Orbi.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Orbi.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Orbi.LabelSmall</item>

        <!-- Formas -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Orbi.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Orbi.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Orbi.Large</item>

        <!-- Componentes -->
        <item name="materialButtonStyle">@style/Widget.Orbi.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Orbi.Card</item>
        <item name="textInputStyle">@style/Widget.Orbi.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.Orbi.Chip.Filter</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Orbi.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Orbi.Dialog</item>
        <item name="snackbarStyle">@style/Widget.Material3.Snackbar</item>

        <!-- Barras do sistema -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.Orbi_app" parent="Base.Theme.Orbi_app" />

    <style name="ThemeOverlay.Orbi.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Orbi.Radius16</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Orbi.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Orbi.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Orbi.Button.DialogPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Orbi.Button.DialogNegative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Orbi.Button.DialogNegative</item>
    </style>
</resources>
