<?xml version="1.0" encoding="utf-8"?>
<!-- Item da timeline de paradas -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="16dp">

    <!-- Marcador da sequência -->
    <FrameLayout
        android:id="@+id/layoutStepCircle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circle"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:backgroundTint="@color/status_in_progress_bg">

        <TextView
            android:id="@+id/tvSequence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            tools:text="1"
            tools:textColor="@color/status_in_progress" />

        <ImageView
            android:id="@+id/ivStepIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <!-- Linha conectora -->
    <View
        android:id="@+id/viewTimelineLine"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:background="?attr/colorOutlineVariant"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/layoutStepCircle"
        app:layout_constraintStart_toStartOf="@id/layoutStepCircle"
        app:layout_constraintTop_toBottomOf="@id/layoutStepCircle" />

    <!-- Conteúdo -->
    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:orientation="vertical"
        android:paddingBottom="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/layoutStepCircle"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRecipient"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Mariana Costa" />

            <TextView
                android:id="@+id/tvWaypointStatus"
                style="@style/Widget.Orbi.StatusPill"
                android:layout_marginStart="12dp"
                tools:backgroundTint="@color/status_pending_bg"
                tools:text="Pendente"
                tools:textColor="@color/status_pending" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Rua das Flores, 123 · Centro, São Paulo" />

        <!-- Telefone: toque para ligar (alvo mínimo de 48dp) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhone"
            style="@style/Widget.Orbi.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:icon="@drawable/ic_phone"
            app:iconSize="18dp"
            tools:text="(11) 98765-4321" />

        <!-- Justificativa (pulado / cancelado) -->
        <TextView
            android:id="@+id/tvJustification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_container"
            android:backgroundTint="?attr/colorSurfaceContainer"
            android:drawablePadding="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_info"
            app:drawableTint="?attr/colorOnSurfaceVariant"
            tools:text="Motivo: Destinatário ausente"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
