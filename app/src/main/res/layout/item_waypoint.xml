<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Coluna da Linha do Tempo (Timeline Indicator) -->
    <LinearLayout
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Círculo do Step -->
        <FrameLayout
            android:id="@+id/layoutStepCircle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/primary_container">

            <TextView
                android:id="@+id/tvSequence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="1"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Linha vertical conectora -->
        <View
            android:id="@+id/viewTimelineLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/divider" />
    </LinearLayout>

    <!-- Card da Parada / Entrega -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/surface_white"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Nome do Destinatário -->
                <TextView
                    android:id="@+id/tvRecipient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/tvWaypointStatus"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Carlos Mendes"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Badge de Status em Pílula -->
                <TextView
                    android:id="@+id/tvWaypointStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_badge_rounded"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="Pendente"
                    android:textColor="@color/status_pending"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Endereço Completo -->
            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Av. Paulista, 1578 - Bela Vista, São Paulo"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Telefone de Contato -->
            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Contato: (11) 98765-4321"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <!-- Justificativa (caso pulado ou cancelado) -->
            <TextView
                android:id="@+id/tvJustification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/status_skipped_bg"
                android:padding="8dp"
                android:text="Motivo: Destinatário ausente"
                android:textColor="@color/status_skipped"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
