<?xml version="1.0" encoding="utf-8"?>
<!-- Card de rota: o card inteiro é o alvo de toque (sem botões redundantes). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoute"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Código + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/route_label"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvRouteCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="RT-2048" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRouteStatus"
                style="@style/Widget.Orbi.StatusPill"
                android:layout_marginStart="12dp"
                tools:backgroundTint="@color/status_in_progress_bg"
                tools:text="Em andamento"
                tools:textColor="@color/status_in_progress" />
        </LinearLayout>

        <!-- Metadados -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                style="@style/Widget.Orbi.MetaIcon"
                android:src="@drawable/ic_place" />

            <TextView
                android:id="@+id/tvTotalStops"
                style="@style/Widget.Orbi.MetaText"
                tools:text="8 paradas" />

            <ImageView
                style="@style/Widget.Orbi.MetaIcon"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_schedule" />

            <TextView
                android:id="@+id/tvEstimatedTime"
                style="@style/Widget.Orbi.MetaText"
                tools:text="~95 min" />
        </LinearLayout>

        <!-- Progresso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBarRoute"
                style="@style/Widget.Orbi.LinearProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:max="100"
                tools:progress="40" />

            <TextView
                android:id="@+id/tvProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFeatureSettings="tnum"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="3/8" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
