<?xml version="1.0" encoding="utf-8"?>
<!--
    Navegação em Tempo Real — Layout moderno e minimalista.
    - Mapa Google Maps em tela cheia (ângulo 30°, customMapStyle JSONs) com padding dinâmico
      para que câmera e logo do Google respeitem os painéis sobrepostos.
    - Topo: cartão compacto de manobra (ícone, distância e instrução) com linha discreta de destino/GPS.
    - Base: painel ancorado (bottom sheet) com ETA em destaque, dados da parada e
      ações Drag-to-Confirm em zonas neutras que só ganham cor quando armadas.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/map_background"
    tools:context=".ui.map.NavigationMapActivity">

    <!-- Mapa Real Google Maps 3D -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===================== Topo: Cartão de Manobra ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTopBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/nav_maneuver_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Ícone de manobra: quadrado arredondado na cor da marca -->
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_rounded_container"
                    android:backgroundTint="@color/primary">

                    <ImageView
                        android:id="@+id/ivManeuverIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/navigation_title"
                        android:src="@drawable/ic_turn_straight"
                        app:tint="@color/white" />
                </FrameLayout>

                <!-- Distância (valor em destaque) e instrução -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvManeuverDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/nav_calculating"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvManeuverInstruction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/nav_maneuver_follow"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/nav_on_maneuver_secondary" />
                </LinearLayout>

                <!-- Sair da navegação (discreto) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseNav"
                    style="@style/Widget.Orbi.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/nav_close_button_bg"
                    android:contentDescription="@string/cd_close_navigation"
                    android:tooltipText="@string/cd_close_navigation"
                    app:icon="@drawable/ic_close"
                    app:iconSize="20dp"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <!-- Faixa Secundária "A seguir" (Uber Driver Stacked Maneuver) -->
            <LinearLayout
                android:id="@+id/layoutNextManeuver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_rounded_container"
                android:backgroundTint="#1E293B"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A seguir"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/nav_on_maneuver_tertiary"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivNextManeuverIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_turn_right"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvNextManeuverInstruction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/white"
                    tools:text="Vire à direita na Av. Rebouças" />
            </LinearLayout>

            <!-- Linha discreta: destino + status do GPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvNavHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/nav_on_maneuver_tertiary"
                    tools:text="Indo para a parada 1 · Maria Silva" />

                <View
                    android:id="@+id/viewGpsDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/nav_gps_ok" />

                <TextView
                    android:id="@+id/tvGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/nav_gps_acquiring"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/nav_on_maneuver_tertiary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Velocímetro estilo Uber Driver (Canto inferior esquerdo acima do painel) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSpeedometer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/cardBottomControls"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCurrentSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:text="0"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="km/h"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="9sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Alternar Visão Geral da Rota / Modo 3D (Uber Driver Overview Toggle) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabRouteOverview"
        style="@style/Widget.Material3.FloatingActionButton.Surface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/btn_view_map"
        android:tooltipText="@string/btn_view_map"
        app:backgroundTint="?attr/colorSurfaceContainerLowest"
        app:elevation="4dp"
        app:fabSize="mini"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Orbi.Full"
        app:layout_constraintBottom_toTopOf="@id/fabRecenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_route"
        app:tint="?attr/colorOnSurface" />

    <!-- Recentralizar no veículo -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabRecenter"
        style="@style/Widget.Material3.FloatingActionButton.Surface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/cd_recenter"
        android:tooltipText="@string/cd_recenter"
        app:backgroundTint="?attr/colorSurfaceContainerLowest"
        app:elevation="4dp"
        app:fabSize="mini"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Orbi.Full"
        app:layout_constraintBottom_toTopOf="@id/cardBottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_my_location"
        app:tint="?attr/colorPrimary" />

    <!-- ===================== Base: Painel ancorado ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardElevation="16dp"
        app:shapeAppearance="@style/ShapeAppearance.Orbi.BottomSheet"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/layoutSheetContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- Cabeçalho Tátil Unificado (Alça + Métricas + Endereço respondem ao toque e arraste vertical) -->
            <LinearLayout
                android:id="@+id/layoutSheetHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="@string/cd_expand_sheet"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <!-- 1. Alça / Badge de Arraste com área de toque ampliada -->
                <FrameLayout
                    android:id="@+id/layoutDragBadge"
                    android:layout_width="match_parent"
                    android:layout_height="20dp">

                    <View
                        android:id="@+id/viewDragHandle"
                        android:layout_width="44dp"
                        android:layout_height="5dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_rounded_container"
                        android:backgroundTint="?attr/colorOutlineVariant" />
                </FrameLayout>

                <!-- 2. Linha 1: Métricas Essenciais da Rota (Duração, Distância, Horário Previsto + Chevron) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNavDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="-- min"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:importantForAccessibility="no"
                        android:text="·"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOutline" />

                    <TextView
                        android:id="@+id/tvNavDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="-- km"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:importantForAccessibility="no"
                        android:text="·"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOutline" />

                    <TextView
                        android:id="@+id/tvNavArrivalTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum"
                        android:text="--:--"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:id="@+id/ivSheetChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_up"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- 3. Linha 2: Endereço da Parada e Sequência -->
                <LinearLayout
                    android:id="@+id/layoutAddressInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNavSequence"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_rounded_container"
                        android:backgroundTint="?attr/colorPrimaryContainer"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textStyle="bold"
                        tools:text="#01" />

                    <TextView
                        android:id="@+id/tvNavAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Av. Paulista, 1000 — Bela Vista, São Paulo" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== CONTEÚDO EXPANSÍVEL (REVELADO AO ARRASTAR PARA CIMA) ===================== -->
            <LinearLayout
                android:id="@+id/layoutExpandableContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Divisor sutil -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="?attr/colorSurfaceContainerHigh" />

                <!-- 4. Bloco de Resumo da Rota (Progresso, Etapa Atual e Próxima Parada) -->
                <LinearLayout
                    android:id="@+id/layoutRouteDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rounded_container"
                    android:backgroundTint="?attr/colorSurfaceContainerLow"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvExpandedRouteCode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            tools:text="ROTA-ORBI-01" />

                        <TextView
                            android:id="@+id/tvExpandedStopStage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_container"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textStyle="bold"
                            tools:text="Em trânsito" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvExpandedRouteProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Parada 1 de 4 · 0 concluídas" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressRouteStops"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="25"
                        app:indicatorColor="?attr/colorPrimary"
                        app:trackColor="?attr/colorSurfaceContainerHighest"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp" />

                    <TextView
                        android:id="@+id/tvExpandedNextStop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Próxima: #02 — Rua Augusta, 1200" />
                </LinearLayout>

                <!-- 5. Informações do Cliente (logo em cima dos botões de ação) -->
                <LinearLayout
                    android:id="@+id/layoutCustomerInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cliente / Destinatário"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOutline" />

                        <TextView
                            android:id="@+id/tvNavRecipient"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            tools:text="Maria Silva" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCallRecipient"
                        style="@style/Widget.Orbi.IconButton.Tonal"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/cd_call_recipient"
                        app:icon="@drawable/ic_phone"
                        app:iconSize="20dp" />
                </LinearLayout>

                <!-- 5. Botões de Ação Radiais Neutros (Pular e Cancelar) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <!-- Botão Radial: Pular -->
                    <com.orbi.orbi_app.ui.map.RadialHoldButton
                        android:id="@+id/btnRadialSkip"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1" />

                    <!-- Botão Radial: Cancelar -->
                    <com.orbi.orbi_app.ui.map.RadialHoldButton
                        android:id="@+id/btnRadialCancel"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- 6. Slide Button Horizontal de Conclusão de Entrega -->
                <com.orbi.orbi_app.ui.map.HorizontalSlideToConfirmView
                    android:id="@+id/slideConcludeDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
