<?xml version="1.0" encoding="utf-8"?>
<!--
    Navegação em Tempo Real — Layout moderno e minimalista.
    - Mapa Google Maps em tela cheia (ângulo 30°, customMapStyle JSONs) com padding dinâmico
      para que câmera e logo do Google respeitem os painéis sobrepostos.
    - Topo: cartão compacto de manobra (ícone, distância e instrução) com linha discreta de destino/GPS.
    - Base: painel ancorado (bottom sheet) com ETA em destaque, dados da parada e
      ações Drag-to-Confirm em zonas neutras que só ganham cor quando armadas.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/map_background"
    tools:context=".ui.map.NavigationMapActivity">

    <!-- Mapa Real Google Maps 3D -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===================== Topo: Cartão de Manobra ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTopBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/nav_maneuver_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Ícone de manobra: quadrado arredondado na cor da marca -->
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_rounded_container"
                    android:backgroundTint="@color/primary">

                    <ImageView
                        android:id="@+id/ivManeuverIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/navigation_title"
                        android:src="@drawable/ic_turn_straight"
                        app:tint="@color/white" />
                </FrameLayout>

                <!-- Distância (valor em destaque) e instrução -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvManeuverDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/nav_calculating"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvManeuverInstruction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/nav_maneuver_follow"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/nav_on_maneuver_secondary" />
                </LinearLayout>

                <!-- Sair da navegação (discreto) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseNav"
                    style="@style/Widget.Orbi.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/nav_close_button_bg"
                    android:contentDescription="@string/cd_close_navigation"
                    android:tooltipText="@string/cd_close_navigation"
                    app:icon="@drawable/ic_close"
                    app:iconSize="20dp"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <!-- Linha discreta: destino + status do GPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvNavHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/nav_on_maneuver_tertiary"
                    tools:text="Indo para a parada 1 · Maria Silva" />

                <View
                    android:id="@+id/viewGpsDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/nav_gps_ok" />

                <TextView
                    android:id="@+id/tvGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/nav_gps_acquiring"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/nav_on_maneuver_tertiary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Recentralizar no veículo -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabRecenter"
        style="@style/Widget.Material3.FloatingActionButton.Surface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/cd_recenter"
        android:tooltipText="@string/cd_recenter"
        app:backgroundTint="?attr/colorSurfaceContainerLowest"
        app:elevation="4dp"
        app:fabSize="mini"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Orbi.Full"
        app:layout_constraintBottom_toTopOf="@id/cardBottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_my_location"
        app:tint="?attr/colorPrimary" />

    <!-- ===================== Base: Painel ancorado ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:cardElevation="16dp"
        app:shapeAppearance="@style/ShapeAppearance.Orbi.BottomSheet"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/layoutSheetContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Alça -->
            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_rounded_container"
                android:backgroundTint="?attr/colorOutlineVariant" />

            <!-- ETA em destaque: duração (valor principal) + distância e horário de chegada -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNavDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="-- min"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvNavDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:text="-- km"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:importantForAccessibility="no"
                            android:text="·"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOutline" />

                        <TextView
                            android:id="@+id/tvNavArrivalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:text="--:--"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallRecipient"
                    style="@style/Widget.Orbi.IconButton.Tonal"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/cd_call_recipient"
                    app:icon="@drawable/ic_phone"
                    app:iconSize="20dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/colorSurfaceContainerHigh" />

            <!-- Parada atual: sequência, destinatário e endereço -->
            <LinearLayout
                android:id="@+id/layoutStopInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNavSequence"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_rounded_container"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textStyle="bold"
                    tools:text="#01" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNavRecipient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Maria Silva" />

                    <TextView
                        android:id="@+id/tvNavAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Av. Paulista, 1000 — Bela Vista, São Paulo" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ações Drag-to-Confirm (Pular, Avançar/Concluir) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <!-- 1. PULAR / OPÇÕES DA PARADA -->
                <FrameLayout
                    android:id="@+id/layoutZoneSkip"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_drag_zone_skip"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_up"
                            app:tint="?attr/colorOutline" />

                        <TextView
                            style="@style/Widget.Orbi.NavActionLabel"
                            android:text="@string/btn_skip_stop" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnCircleSkip"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:background="@drawable/bg_action_circle_skip"
                        android:contentDescription="@string/btn_skip_stop"
                        android:elevation="2dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_skip"
                            app:tint="@color/white" />
                    </FrameLayout>
                </FrameLayout>

                <!-- 2. AVANÇAR / CONCLUIR -->
                <FrameLayout
                    android:id="@+id/layoutZoneComplete"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_drag_zone_complete"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_up"
                            app:tint="?attr/colorOutline" />

                        <TextView
                            android:id="@+id/tvCompleteLabel"
                            style="@style/Widget.Orbi.NavActionLabel"
                            android:text="@string/nav_action_complete" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnCircleComplete"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:background="@drawable/bg_action_circle_complete"
                        android:contentDescription="@string/btn_complete_stop"
                        android:elevation="2dp">

                        <ImageView
                            android:id="@+id/ivCompleteIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check"
                            app:tint="@color/white" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Dica do gesto -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/nav_drag_hint"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOutline" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
