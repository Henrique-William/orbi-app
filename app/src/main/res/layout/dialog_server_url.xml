<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de URL personalizada para o diálogo de servidor -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/server_custom_hint"
        app:helperText="@string/server_custom_helper"
        app:startIconDrawable="@drawable/ic_dns">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
